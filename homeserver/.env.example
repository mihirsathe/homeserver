# =============================================================================
# .env.example — copy to .env and fill in every value marked FILL IN.
#
# These are the only values you ever type. Everything else (API keys,
# STACK_DIR, PLEX_TOKEN) is generated by the scripts and lives in
# generated.env, which is written automatically and gitignored.
# =============================================================================

# ---------------------------------------------------------------------------
# System
# PUID/PGID are Unraid's nobody:users — do not change
# ---------------------------------------------------------------------------
PUID=99
PGID=100
TZ=              # FILL IN — e.g. America/New_York, America/Los_Angeles, Europe/London

# ---------------------------------------------------------------------------
# Tailscale split DNS
# AdGuard Home runs in the stack as the tailnet DNS resolver. Tailscale's
# admin console rule (DNS → Restricted nameservers → domain `lan`) sends
# every *.lan query to <TAILNET_HOST_IP>:53, where AdGuard answers with
# this same IP via a wildcard rewrite. Result: every device on the tailnet
# resolves radarr.lan / sonarr.lan / etc. with zero per-device config.
#
# Get the value with `tailscale ip -4` from the Unraid terminal.
# ---------------------------------------------------------------------------
TAILNET_HOST_IP=     # FILL IN — e.g. 100.64.1.7

# ---------------------------------------------------------------------------
# Caddy's own tailnet node (ts-caddy sidecar)
#
# Unraid's web GUI owns the host's port 80 and keeps it — that path works with
# Docker stopped, so it's the emergency way in. Admin URLs still need to be
# port-free (http://radarr.lan, no port suffix), so Caddy gets its own IP not
# its own port: the ts-caddy sidecar joins the tailnet as a separate node and
# Caddy serves on that node's address.
#
# TS_AUTHKEY: admin console → Settings → Keys → Generate auth key.
#   Must be REUSABLE and NOT ephemeral, tagged tag:server. Ephemeral nodes are
#   torn down when offline and return with a different IP, which orphans
#   AdGuard's *.lan rewrite. Only used for first login — after that the node
#   identity lives in /mnt/user/appdata/ts-caddy.
#
# CADDY_TAILNET_IP: leave blank on first run — it doesn't exist yet. Bring the
#   sidecar up, read its address, then fill this in and re-run
#   generate-configs.py --force-overwrite:
#     docker compose --env-file .env.docker up -d ts-caddy
#     docker exec ts-caddy tailscale ip -4
# ---------------------------------------------------------------------------
TS_AUTHKEY=          # FILL IN — tskey-auth-... (reusable, non-ephemeral, tag:server)
CADDY_TAILNET_IP=    # FILL IN on the second pass — e.g. 100.64.1.9
CADDY_TS_HOSTNAME=caddy   # → caddy.<your-tailnet>.ts.net via MagicDNS

# ---------------------------------------------------------------------------
# Mullvad WireGuard (Gluetun outbound VPN for SAB + Prowlarr)
# Generate a key at mullvad.net/account → WireGuard configuration.
# Pick one config, copy the PrivateKey and Address fields verbatim.
# ---------------------------------------------------------------------------
VPN_PRIVATE_KEY=     # FILL IN — base64 WireGuard private key from Mullvad
VPN_ADDRESS=         # FILL IN — e.g. 10.64.x.x/32,fc00:bbbb:...::/128
VPN_CITY=Amsterdam   # pick a city near your Usenet provider for lowest latency

# ---------------------------------------------------------------------------
# Usenet — primary provider
#
# IMPORTANT: register Usenet and indexer accounts over a Mullvad exit — the
# easiest path is the Mullvad app on a laptop/phone before the stack is up.
# Once the provider has logged a home-IP session on an account, that
# association can't be undone. Pay in Monero where possible.
# ---------------------------------------------------------------------------
USENET_HOST=         # FILL IN — e.g. news.newshosting.com
USENET_PORT=563      # SSL port — do not use 119
USENET_SSL=1
USENET_USER=         # FILL IN
USENET_PASS=         # FILL IN
USENET_CONNECTIONS=20  # FILL IN — check your plan limit

# Fill/backup server — different backbone from primary. Leave blank if unused.
USENET_FILL_HOST=
USENET_FILL_USER=
USENET_FILL_PASS=
USENET_FILL_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Indexers (from each site's account page — register via Mullvad IP)
# ---------------------------------------------------------------------------
NZBGEEK_API_KEY=    # FILL IN — nzbgeek.info → My Profile → API Key
NZBPLANET_API_KEY=  # FILL IN — nzbplanet.net → My Account → API Key

# ---------------------------------------------------------------------------
# Plex
# ---------------------------------------------------------------------------
PLEX_SERVER_NAME=Home Media Server  # shown in Plex clients — change if desired

# Your server's LAN IP — shown in Unraid UI top-right corner
PLEX_LAN_IP=     # FILL IN — e.g. 192.168.1.50

# Your LAN subnet in CIDR — tells Plex to direct-play on LAN, no transcode
# ip route | grep default on any LAN device: 192.168.1.1 → 192.168.1.0/24
PLEX_LAN_SUBNET= # FILL IN — e.g. 192.168.1.0/24

# One-time claim token — links this server to your Plex account on first start.
# Get it at https://plex.tv/claim immediately before running docker compose up (expires in 4 min).
# bootstrap.py blanks this out in generated.env after a successful claim;
# leave it in .env so re-runs of generate-configs.py don't re-prompt.
PLEX_CLAIM=   # FILL IN — right before Step 4

# ---------------------------------------------------------------------------
# Local AI (Ollama) — every value here is OPTIONAL
#
# The compose file carries working defaults; these exist so you can tune the
# GPU split without editing docker-compose.yml. Ollama is the second-priority
# tenant of the RTX 3050 — Plex always wins. See docs/decisions.md#local-ai-on-
# the-transcode-gpu for why this is two settings and not a scheduler.
#
# Apply changes with:
#   docker compose --env-file .env.docker up -d
# (re-run generate-configs.py first if you edited anything else in .env)
# ---------------------------------------------------------------------------

# VRAM (in bytes) that Ollama must never allocate, leaving it free for Plex's
# NVENC sessions. This is the most important knob here — it's what actually
# guarantees a transcode can always start, and it holds unconditionally.
#   1073741824 = 1.0 GiB   — a few concurrent 1080p transcodes
#   2147483648 = 2.0 GiB   — default; ~2 concurrent 4K HDR tone-mapping streams
#   3221225472 = 3.0 GiB   — paranoid; leaves ~3 GB for models on a 6 GB card
# Raising this shrinks the largest model that fits fully on the GPU. Ollama
# spills the overflow to CPU rather than failing, so the failure mode is
# "slower", not "broken". Raise it if you ever see Plex fall back to CPU
# transcoding while a model is loaded.
OLLAMA_GPU_OVERHEAD_BYTES=2147483648

# How long an idle model stays resident in VRAM before Ollama unloads it.
# This is Ollama's own eviction mechanism and the only dynamic one here.
# Upstream default is 5m; 60s hands the card back much sooner, at the cost of
# re-loading (a few seconds off SSD) if you come back after a pause.
OLLAMA_KEEP_ALIVE=60s

# Context window. KV cache VRAM scales linearly with this — going to 16384
# on a 6 GB card can cost more VRAM than the model weights themselves.
OLLAMA_CONTEXT_LENGTH=4096

# KV cache precision. q8_0 halves KV cache VRAM at a quality difference that
# isn't measurable on 3–8B models; set to f16 to opt out. (Requires flash
# attention, which docker-compose.yml enables unconditionally.)
OLLAMA_KV_CACHE_TYPE=q8_0

# Requests to queue once the single model slot is busy, before Ollama rejects.
OLLAMA_MAX_QUEUE=64

# ---------------------------------------------------------------------------
# Backup (optional — backup-appdata.sh reads these)
# ---------------------------------------------------------------------------
# Days of local backups to keep in /mnt/user/backups/appdata before pruning.
BACKUP_LOCAL_RETENTION_DAYS=14

# Optional offsite target. Configure with `rclone config` on the host first,
# then set this to the rclone remote name + path (e.g. "b2:my-bucket/backups").
# Leave blank to skip offsite copy (local backups still run).
BACKUP_REMOTE=

# ---------------------------------------------------------------------------
# Note: STACK_DIR is auto-derived by generate-configs.py from the script's
# own location and written to generated.env. Don't set it manually here.
# ---------------------------------------------------------------------------
