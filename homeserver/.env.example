# =============================================================================
# .env.example — copy to .env and fill in every value marked FILL IN.
#
# These are the only values you ever type. Everything else (API keys,
# STACK_DIR, PLEX_TOKEN) is generated by the scripts and lives in
# generated.env, which is written automatically and gitignored.
# =============================================================================

# ---------------------------------------------------------------------------
# System
# PUID/PGID are Unraid's nobody:users — do not change
# ---------------------------------------------------------------------------
PUID=99
PGID=100
TZ=              # FILL IN — e.g. America/New_York, America/Los_Angeles, Europe/London

# ---------------------------------------------------------------------------
# Mullvad WireGuard (Gluetun outbound VPN for SAB + Prowlarr)
# Generate a key at mullvad.net/account → WireGuard configuration.
# Pick one config, copy the PrivateKey and Address fields verbatim.
# ---------------------------------------------------------------------------
VPN_PRIVATE_KEY=     # FILL IN — base64 WireGuard private key from Mullvad
VPN_ADDRESS=         # FILL IN — e.g. 10.64.x.x/32,fc00:bbbb:...::/128
VPN_CITY=Amsterdam   # pick a city near your Usenet provider for lowest latency

# ---------------------------------------------------------------------------
# Usenet — primary provider
#
# IMPORTANT: register your Usenet and indexer accounts from the Mullvad exit
# IP AFTER Gluetun is up. Any account registered from your home IP is
# permanently tainted in the provider's logs. Pay in Monero where possible.
# ---------------------------------------------------------------------------
USENET_HOST=         # FILL IN — e.g. news.newshosting.com
USENET_PORT=563      # SSL port — do not use 119
USENET_SSL=1
USENET_USER=         # FILL IN
USENET_PASS=         # FILL IN
USENET_CONNECTIONS=20  # FILL IN — check your plan limit

# Fill/backup server — different backbone from primary. Leave blank if unused.
USENET_FILL_HOST=
USENET_FILL_USER=
USENET_FILL_PASS=
USENET_FILL_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Indexers (from each site's account page — register via Mullvad IP)
# ---------------------------------------------------------------------------
NZBGEEK_API_KEY=    # FILL IN — nzbgeek.info → My Profile → API Key
NZBPLANET_API_KEY=  # FILL IN — nzbplanet.net → My Account → API Key

# ---------------------------------------------------------------------------
# Plex
# ---------------------------------------------------------------------------
PLEX_SERVER_NAME=Home Media Server  # shown in Plex clients — change if desired

# Your server's LAN IP — shown in Unraid UI top-right corner
PLEX_LAN_IP=     # FILL IN — e.g. 192.168.1.50

# Your LAN subnet in CIDR — tells Plex to direct-play on LAN, no transcode
# ip route | grep default on any LAN device: 192.168.1.1 → 192.168.1.0/24
PLEX_LAN_SUBNET= # FILL IN — e.g. 192.168.1.0/24

# One-time claim token — links this server to your Plex account on first start.
# Get it at https://plex.tv/claim immediately before running docker compose up (expires in 4 min).
# bootstrap.py blanks this out in generated.env after a successful claim;
# leave it in .env so re-runs of generate-configs.py don't re-prompt.
PLEX_CLAIM=   # FILL IN — right before Step 4

# ---------------------------------------------------------------------------
# Backup (optional — backup-appdata.sh reads these)
# ---------------------------------------------------------------------------
# Days of local backups to keep in /mnt/user/backups/appdata before pruning.
BACKUP_LOCAL_RETENTION_DAYS=14

# Optional offsite target. Configure with `rclone config` on the host first,
# then set this to the rclone remote name + path (e.g. "b2:my-bucket/backups").
# Leave blank to skip offsite copy (local backups still run).
BACKUP_REMOTE=

# ---------------------------------------------------------------------------
# Note: STACK_DIR is auto-derived by generate-configs.py from the script's
# own location and written to generated.env. Don't set it manually here.
# ---------------------------------------------------------------------------
