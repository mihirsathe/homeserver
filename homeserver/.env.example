# =============================================================================
# .env.example
# Copy to .env and fill every FILL IN before running anything.
#
# This is the only file you edit. generate-configs.py reads it and writes
# every app config file. bootstrap.py reads it to wire apps together via API.
# =============================================================================

# ---------------------------------------------------------------------------
# System — Unraid-specific defaults, do not change PUID/PGID
# ---------------------------------------------------------------------------
PUID=99          # Unraid's nobody user — owns all container processes
PGID=100         # Unraid's users group — required for share access
TZ=              # FILL IN — e.g. America/Los_Angeles, America/New_York, Europe/London

# ---------------------------------------------------------------------------
# API keys — generate one UUID per key before running generate-configs.py
# Run this four times on the Unraid terminal:
#   cat /proc/sys/kernel/random/uuid
# Each app reads its key from its config file on first boot.
# Copy these same keys into bootstrap.py's API calls automatically —
# you only set them here.
# ---------------------------------------------------------------------------
SABNZBD_API_KEY=   # FILL IN
RADARR_API_KEY=    # FILL IN
SONARR_API_KEY=    # FILL IN
LIDARR_API_KEY=    # FILL IN
PROWLARR_API_KEY=  # FILL IN

# ---------------------------------------------------------------------------
# Usenet provider — primary server
# ---------------------------------------------------------------------------
USENET_HOST=         # FILL IN — e.g. news.newshosting.com
USENET_PORT=563      # SSL port — do not use 119
USENET_SSL=1
USENET_USER=         # FILL IN
USENET_PASS=         # FILL IN
USENET_CONNECTIONS=20  # FILL IN — check your plan limit

# Fill/backup server (different backbone from primary — delete both if unused)
USENET_FILL_HOST=         # FILL IN or leave blank
USENET_FILL_USER=         # FILL IN or leave blank
USENET_FILL_PASS=         # FILL IN or leave blank
USENET_FILL_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Indexer API keys (from each site's account/profile page)
# ---------------------------------------------------------------------------
NZBGEEK_API_KEY=    # FILL IN — from nzbgeek.info → My Profile → API Key
NZBPLANET_API_KEY=  # FILL IN — from nzbplanet.net → My Account → API Key

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=  # FILL IN — from Zero Trust → Networks → Tunnels → your tunnel → Token

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
DOMAIN=  # FILL IN — e.g. smithmedia.net (registered via Cloudflare Registrar)

# ---------------------------------------------------------------------------
# Plex
# ---------------------------------------------------------------------------

# Get from https://www.plex.tv/claim — EXPIRES IN 4 MINUTES
# Grab this right before running docker compose up for the first time.
# After first successful start, clear this value so it doesn't re-claim on restart.
PLEX_CLAIM=  # FILL IN immediately before first docker compose up

# Your server's LAN IP — shown in Unraid UI top-right corner
PLEX_LAN_IP=  # FILL IN — e.g. 192.168.1.50

# Your LAN subnet in CIDR notation — tells Plex to direct-play on LAN (no transcode)
# To find it: run  ip route | grep default  on any device on your home network
# If your router's IP is 192.168.1.1  →  use 192.168.1.0/24
# If your router's IP is 192.168.0.1  →  use 192.168.0.0/24
# If your router's IP is 10.0.0.1     →  use 10.0.0.0/24
PLEX_LAN_SUBNET=  # FILL IN — e.g. 192.168.1.0/24

PLEX_SERVER_NAME=Home Media Server  # Shown in Plex clients — change if desired

# After running bootstrap.py once, add your Plex token here so the script
# can create libraries. Find it: Plex Web → Settings → General → scroll to bottom → Show
PLEX_TOKEN=  # FILL IN after first boot
